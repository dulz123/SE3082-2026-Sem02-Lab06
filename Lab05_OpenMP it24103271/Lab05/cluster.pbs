#!/bin/bash
# PBS/OpenPBS example; ask your cluster admin whether these resource names apply.
#PBS -N openmp_lab
#PBS -l select=1:ncpus=4:ompthreads=4
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 OMP_DYNAMIC=FALSE
make
./bin/ex1_barrier
./bin/ex4_outer
./bin/ex4_collapse
